{
  "name": "shariful-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "db:check": "node --conditions=react-server --import tsx scripts/database.ts",
    "db:indexes": "node --conditions=react-server --import tsx scripts/database.ts --indexes",
    "check:client-secrets": "node --import tsx scripts/check-client-secrets.ts",
    "db:verify": "node --conditions=react-server --import tsx scripts/verify-database.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.7",
    "@next/env": "16.3.8",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "better-auth": "1.7.7",
    "cloudinary": "2.11.0",
    "mongodb": "7.7.0",
    "motion": "14.0.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-sanitize": "6.0.0",
    "server-only": "0.0.1",
    "three": "0.182.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.182.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
