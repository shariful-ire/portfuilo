# The public shell loads without credentials; saved content/auth/contact need configuration.
# Step 2 database functions and CLI commands require BOTH MongoDB variables.
# Copy to .env.local when configuring integrations. Never commit real secrets.
# Keep credentials server-only; never prefix secrets with NEXT_PUBLIC_.
# Atlas mongodb+srv:// or local mongodb:// connection string, with credentials.
MONGODB_URI=
# Explicit database name: letters, numbers, underscores, hyphens (max 63).
MONGODB_DB_NAME=
# Step 3: required server-only Google authentication configuration.
# Generate a random secret of at least 32 characters; never reuse examples.
BETTER_AUTH_SECRET=
# Origin only. Production requires HTTPS. Restart after changing these values.
# Google callback: http://localhost:3000/api/auth/callback/google
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this verified Google email can administer the site; never NEXT_PUBLIC_.
ADMIN_EMAIL=
# Step 4: required for server-signed image/PDF uploads and deletion.
# All three stay on the server; no unsigned upload preset is used.
# Enable PDF delivery in Cloudinary security settings if CV links are blocked.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# MongoDB Atlas or a replica set is required for transactional settings/media saves.

# Step 9: required only for the public contact form (server-only).
# Generate a separate cryptographically random secret of at least 32 characters.
CONTACT_FORM_SECRET=
# Exact public origin, no path. Falls back to BETTER_AUTH_URL if empty.
# Development: http://localhost:3000. Production: your actual HTTPS origin.
CONTACT_PUBLIC_ORIGIN=
# Optional trusted ingress header containing ONE client IP (not a comma list).
# Leave blank unless your hosting proxy overwrites this header and direct access
# to the app is blocked. Global/email MongoDB limits remain active when blank.
# Vercel deployments may use x-forwarded-for after verifying the ingress setup.
CONTACT_TRUSTED_IP_HEADER=
# Run db:indexes for contactRateLimits/contactReceipts expiry indexes.

# Step 11: canonical origin only (no path); set to your real HTTPS production URL.
# Local verification may use http://localhost:3000. Never infer it from request headers.
SITE_URL=
# Keep false on localhost and preview deployments. Enable only for public production.
ALLOW_INDEXING=false

# Optional IP-only DNS resolvers when the network blocks Atlas SRV/TXT lookups.
# Leave blank on working networks. Example: 1.1.1.1,8.8.8.8
# Affects Node process DNS resolution, not operating-system DNS settings.
MONGODB_DNS_SERVERS=

# Products/orders/reviews reuse MongoDB, Google admin, Cloudinary and CONTACT_* settings above.
# No payment gateway or notification credentials are used. Orders are requests only.
# Product MP4 uploads: maximum 4 MiB through the authenticated server upload endpoint.
